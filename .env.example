# ---------------------------------------------------------------------------
# MUGIWARA — environment template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Supabase (project URL + publishable/anon key are safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# --- Supabase service role key. SERVER-ONLY. Never expose to the client. ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI providers. SERVER-ONLY. Keep every key out of client code. ---
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Default provider for the AI crew: claude | openai | gemini
AI_DEFAULT_PROVIDER="claude"

# --- Hard cost / safety controls for agent runs (USD + wall-clock seconds) ---
AI_MAX_RUN_COST_USD="2.00"
AI_MAX_AGENT_STEPS="40"
AI_RUN_TIMEOUT_SECONDS="600"
AI_MAX_CONCURRENCY="3"

# --- Isolated execution / preview sandbox (Phase 7). Leave blank to disable. ---
EXECUTION_PROVIDER="none"
EXECUTION_API_URL=""
EXECUTION_API_KEY=""

# --- Deployment provider (Phase 9). Leave blank to disable. ---
DEPLOY_PROVIDER="none"
DEPLOY_API_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MUGIWARA"
